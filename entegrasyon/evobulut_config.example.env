# EvoBulut API kimlik bilgileri — bu dosyayı kopyalayıp evobulut.env olarak kaydedin.
# Gerçek şifreleri git'e eklemeyin (evobulut.env .gitignore'da).
#
# Dokümantasyon: https://dev.evobulut.com
# Canlı endpoint: https://ws.evobulut.com/api

EVOBULUT_BASE_URL=https://ws.evobulut.com/api
EVOBULUT_KULLANICI_KODU=
EVOBULUT_SIFRE=
EVOBULUT_APP=muhasebe_programi
